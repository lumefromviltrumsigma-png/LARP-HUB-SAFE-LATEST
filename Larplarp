local function UpdateAllGuards()
    if not GuardPanel or not GuardPanel.Parent or not GuardInfoEnabled then return end
    local current = {}
    local count = 0
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p:GetAttribute("IsGuard") == true then
            current[p] = true
            count += 1
        end
    end
    for p in pairs(GuardEntries) do if not current[p] then DestroyGuardEntry(p) end end
    for p in pairs(current) do
        if not GuardEntries[p] then CreateGuardEntry(p) end
        UpdateGuardEntry(p)
    end
    local el = GuardPanelList and GuardPanelList:FindFirstChild("EmptyLabel")
    if el then el.Visible = (next(GuardEntries) == nil) end
    if GuardCountLabel then GuardCountLabel.Text = tostring(count) end
end

