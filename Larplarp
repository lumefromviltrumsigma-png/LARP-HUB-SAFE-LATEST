local function findArcadeConsole()
    if ArcadeConsoleCache and ArcadeConsoleCache.Parent then return ArcadeConsoleCache end
    ArcadeConsoleCache = nil
    for _, f in ipairs({Workspace:FindFirstChild("Arcade"),Workspace:FindFirstChild("Arcades"),Workspace:FindFirstChild("Map"),Workspace:FindFirstChild("Interactive"),Workspace:FindFirstChild("Objects")}) do
        if f then
