local function getCurrentGame()
    local values = Workspace:FindFirstChild("Values")
    values = values and values:FindFirstChild("CurrentGame")
    if values and values.Value ~= "" then return values.Value end
    return nil
end

local function isGame(name) return getCurrentGame() == name end

local function setMovementEnabled(enabled)
    local character = LocalPlayer.Character
    if character then
        local humanoid = character:FindFirstChild("Humanoid")
        if humanoid then
            humanoid.WalkSpeed = enabled and 16 or 0
            humanoid.JumpPower = enabled and 50 or 0
        end
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if hrp and not enabled then hrp.Velocity = Vector3.zero end
    end
end

local function isInBox(pos, c1, c2)
    return pos.X >= math.min(c1.X, c2.X) and pos.X <= math.max(c1.X, c2.X)
        and pos.Z >= math.min(c1.Z, c2.Z) and pos.Z <= math.max(c1.Z, c2.Z)
end

local function isInRLGLSafeZone()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return false end
    local pos = character.HumanoidRootPart.Position
    return isInBox(pos, Vector3.new(-216, 0, 83), Vector3.new(103, 0, 168))
        or isInBox(pos, Vector3.new(103, 0, 168), Vector3.new(116, 0, 82))
        or isInBox(pos, Vector3.new(115, 0, -578), Vector3.new(-215, 0, -516))
end

