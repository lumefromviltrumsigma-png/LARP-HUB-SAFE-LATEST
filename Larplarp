local GlassESPEnabled = false
local FakeGlassEnabled = false
local espObjects = {}
local fakeGlassParts = {}
local espThread = nil

pcall(function()
    PhysicsService:RegisterCollisionGroup("LocalPlayerOnly")
    PhysicsService:RegisterCollisionGroup("FakeGlass")
    PhysicsService:CollisionGroupSetCollidable("FakeGlass", "Default", false)
    PhysicsService:CollisionGroupSetCollidable("FakeGlass", "LocalPlayerOnly", true)
end)

local function glassProcessModel(adornee)
    if not adornee:IsA("Model") or not adornee.PrimaryPart then return end
    local pp = adornee.PrimaryPart
    local isBreak = pp:GetAttribute("exploitingisevil")
    if GlassESPEnabled and not espObjects[adornee] then
        local hl = Instance.new("Highlight")
        hl.FillTransparency = 0.5
        hl.OutlineTransparency = 0
        hl.OutlineColor = Color3.new(1, 1, 1)
        if isBreak then hl.FillColor = Color3.fromRGB(255, 50, 50)
        else hl.FillColor = Color3.fromRGB(50, 255, 50) end
        hl.Adornee = adornee
        hl.Parent = adornee
        espObjects[adornee] = hl
    end
    local shouldFake = isBreak
    if FakeGlassEnabled then shouldFake = isBreak == false end
    if shouldFake and not fakeGlassParts[adornee] then
        local p = Instance.new("Part")
        p.Size = pp.Size
        p.CFrame = pp.CFrame * CFrame.new(0, 1, 0)
        p.Anchored = true
        p.CanCollide = true
        p.Transparency = 0.5
        p.Color = Color3.fromRGB(50, 255, 0)
        p.Material = Enum.Material.Glass
        pcall(function() p.CollisionGroup = "FakeGlass" end)
        p.Parent = Workspace
        fakeGlassParts[adornee] = p
    end
end

local function glassCleanup()
    for _, v in pairs(espObjects) do if v and v.Parent then v:Destroy() end end
    table.clear(espObjects)
    for _, v in pairs(fakeGlassParts) do if v and v.Parent then v:Destroy() end end
    table.clear(fakeGlassParts)
end

local function glassLoop()
    if espThread then return end
    espThread = task.spawn(function()
        while GlassESPEnabled or FakeGlassEnabled do
            if Workspace:GetAttribute("GLASSBRIDGEOVER") then glassCleanup() end
            local char = LocalPlayer.Character
            if char then
                local h = char:FindFirstChild("Humanoid")
                if h and h.Health <= 0 then glassCleanup() end
            end
            local gb = Workspace:FindFirstChild("GlassBridge")
            if gb then
                local gh = gb:FindFirstChild("GlassHolder")
                if gh then
                    for _, c in ipairs(gh:GetChildren()) do
                        for _, c2 in ipairs(c:GetChildren()) do glassProcessModel(c2) end
                    end
                end
            end
            task.wait(2)
        end
        espThread = nil
    end)
end

