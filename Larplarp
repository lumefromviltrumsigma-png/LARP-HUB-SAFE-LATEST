local _silentAimState = { Enabled = false, Hooked = false }

local function install_silent_aim_hook()
    if _silentAimState.Hooked then return end
    _silentAimState.Hooked = true
    pcall(function()
        local GF = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("GunFunctions"))
        local orig = GF.FiredGun
        GF.FiredGun = function(arg, arg2, arg3, ...)
            if not _silentAimState.Enabled or arg ~= LocalPlayer.Character then return orig(arg, arg2, arg3, ...) end
            arg3 = arg3 or {}
            local hrp = arg and arg:FindFirstChild("HumanoidRootPart")
            if not hrp then return orig(arg, arg2, arg3, ...) end
            local pos = hrp.Position
            pcall(function()
                local a = arg:GetAttribute("HoldingWeapon")
                if a then
                    local t = arg:FindFirstChild(a)
                    if t then
                        local ff = t:FindFirstChild("FireFrom")
                        if ff then pos = ff.Position end
                    end
                end
            end)
            local isGuard = LocalPlayer:GetAttribute("IsGuard")
            local live = workspace:FindFirstChild("Live")
            local target = nil
            if live then
                local best = math.huge
                for _, c in pairs(live:GetChildren()) do
                    if c ~= arg and not c:FindFirstChild("Dead") and not c:FindFirstChild("IFrame") then
                        local hum = c:FindFirstChild("Humanoid")
                        if not (hum and hum.Health <= 0) then
                            local head = c:FindFirstChild("Head") or c:FindFirstChild("HumanoidRootPart") or c:FindFirstChildWhichIsA("BasePart", true)
                            if head then
                                local chrp = c:FindFirstChild("HumanoidRootPart")
                                local can = false
                                if c:FindFirstChild("Enemy") or string.match(string.lower(c.Name), "peabert") then can = true
                                elseif isGuard then
                                    if c:FindFirstChild("GuardCanKill") or chrp and chrp:FindFirstChild("GuardCanKillLockOn") then can = true end
                                else
                                    local p = Players:GetPlayerFromCharacter(c)
                                    if (p and p ~= LocalPlayer and p:GetAttribute("IsGuard")) or c.Name:match("Rebel") or c.Name:match("Guard") or c:FindFirstChild("PlayerCanKill") or c:FindFirstChild("TypeOfGuard") then can = true end
                                end
                                if isGuard and c:FindFirstChild("TypeOfGuard") and not (chrp and chrp:FindFirstChild("GuardCanKillLockOn")) then can = false end
                                if can then
                                    local d = (head.Position - pos).Magnitude
                                    if d < best and d < 1000 then best = d target = head end
                                end
                            end
                        end
                    end
                end
            end
            if target then
                arg3.CustomFireFrom = true
                arg3.spread = 0
                arg2 = target.Position
            end
            return orig(arg, arg2, arg3, ...)
        end
    end)
end

