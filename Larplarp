local function CleanupAutoDodge()
    for _, c in ipairs(AutoDodgeConnections) do
        if c then pcall(function() c:Disconnect() end) end
    end
    table.clear(AutoDodgeConnections)
end

local function HandleDodgeAnimation(track, hunterHRP)
    if not AutoDodgeEnabled or not isGame("HideAndSeek") then return end
    if tick() - AutoDodgeLastTime < 0.8 then return end
    if not track.Animation then return end

    local animId = track.Animation.AnimationId
    local isDodgeAnim = false
    for _, id in ipairs(AUTO_DODGE_ANIMS) do
        if string.find(animId, id, 1, true) then
            isDodgeAnim = true
            break
        end
    end
    if not isDodgeAnim then return end

    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp or not hunterHRP then return end

    local dist = (hrp.Position - hunterHRP.Position).Magnitude
    local predictDist = (hrp.Position + hrp.Velocity * 0.7 - hunterHRP.Position + hunterHRP.Velocity * 0.7).Magnitude
    local closingSpeed = dist - predictDist
    local facingDot = hunterHRP.CFrame.LookVector:Dot((hrp.Position - hunterHRP.Position).Unit)

    local hunterHumanoid = hunterHRP.Parent and hunterHRP.Parent:FindFirstChild("Humanoid")
    local threatRange = 10

    if hunterHumanoid then
        local animator = hunterHumanoid:FindFirstChild("Animator")
        if animator then
            for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
                if t.Animation then
                    local aid = t.Animation.AnimationId
                    if string.find(aid, "76367328603905") then
                        threatRange = 20
                        break
                    elseif string.find(aid, "71214385249268") then
                        threatRange = 14
                        break
                    end
                end
            end
        end
    end

    if math.abs(hrp.Position.Y - hunterHRP.Position.Y) > 12 then return end

    local threatened = false
    if dist <= 10 then threatened = true end
    if not threatened and predictDist <= threatRange and closingSpeed > -3 then threatened = true end
    if not threatened and dist <= 20 and closingSpeed > 2 then threatened = true end

    if threatened then
        if closingSpeed < -8 and dist > 8 then threatened = false end
        if dist > 14 and facingDot < -0.4 then threatened = false end
    end

    if not threatened then return end

    local rp = RaycastParams.new()
    rp.FilterDescendantsInstances = { character, hunterHRP.Parent }
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local hit = Workspace:Raycast(hrp.Position, hunterHRP.Position - hrp.Position, rp)

    if hit then return end

    local dodge = LocalPlayer.Backpack:FindFirstChild("DODGE!") or character:FindFirstChild("DODGE!")
    if not dodge then return end

    pcall(function()
        local args = { buffer.create(0), { dodge } }
        ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("UsedTool"):FireServer(unpack(args))

        local keyToPress = nil
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        if pg then
            for _, desc in ipairs(pg:GetDescendants()) do
                if (desc:IsA("TextLabel") or desc:IsA("TextButton")) and desc.Text == "DODGE!" then
                    if desc.Parent then
                        for _, child in ipairs(desc.Parent:GetChildren()) do
                            if child ~= desc and (child:IsA("TextLabel") or child:IsA("TextButton")) then
                                local upper = string.upper(tostring(child.Text))
                                if tonumber(upper) or upper == "E" or upper == "T" or upper == "Y" then
                                    keyToPress = tostring(child.Text)
                                    break
                                end
                            end
                        end
                    end
                    if keyToPress then break end
                end
            end
        end

        if not keyToPress then
            local bp = LocalPlayer:FindFirstChild("Backpack")
            if bp then
                local idx = 1
                for _, child in ipairs(bp:GetChildren()) do
                    if child:IsA("Tool") then
                        if child.Name == "DODGE!" then
                            keyToPress = tostring(idx)
                            break
                        else
                            idx += 1
                        end
                    end
                end
            end
        end

        if keyToPress then
            AutoDodgeLastTime = tick()
            PressKey(keyToPress)
            task.wait(0.05)
            PressKey(keyToPress)
        end
    end)
end

local function BindAutoDodgeHunter(player)
    if player == LocalPlayer then return end
    local function onCharacter(character)
        task.wait(0.5)
        if not player:GetAttribute("IsHunter") then return end
        local humanoid = character:FindFirstChild("Humanoid")
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if humanoid and hrp then
            local animator = humanoid:FindFirstChild("Animator")
            if animator then
                local conn = animator.AnimationPlayed:Connect(function(track)
                    HandleDodgeAnimation(track, hrp)
                end)
                table.insert(AutoDodgeConnections, conn)
            end
        end
    end
    if player.Character then task.spawn(onCharacter, player.Character) end
    table.insert(AutoDodgeConnections, player.CharacterAdded:Connect(onCharacter))
    table.insert(AutoDodgeConnections, player:GetAttributeChangedSignal("IsHunter"):Connect(function()
        if player.Character then task.spawn(onCharacter, player.Character) end
    end))
end

