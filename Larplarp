        pcall(function() ArcadeCurrentGame.Stopping = true ArcadeCurrentGame:Destroy() end)
        ArcadeCurrentGame = nil
    end
    local g = ArcadeGameModule.new(console, hrp)
    ArcadeCurrentGame = g
    g:start()
    local t = os.clock()
    while g.State ~= "Running" and os.clock() - t < 3 do
        if not ArcadeAutoFarmEnabled then pcall(function() g:Destroy() end) ArcadeCurrentGame = nil return end
        task.wait(0.1)
