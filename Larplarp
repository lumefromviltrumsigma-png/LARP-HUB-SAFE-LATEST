local function GetGuardLevel(player)
    local char = player.Character
    local levelNames = {"Level","_Level","GuardLevel","Guard_Level","PlayerLevel","LVL","lvl","Prestige","Rank","_Rank"}
    for _, n in ipairs(levelNames) do
        local ok, v = pcall(function() return player:GetAttribute(n) end)
        if ok and v ~= nil and v ~= "" then return tostring(v) end
        if char then
            local ok2, v2 = pcall(function() return char:GetAttribute(n) end)
            if ok2 and v2 ~= nil and v2 ~= "" then return tostring(v2) end
        end
    end
    local ok, attrs = pcall(function() return player:GetAttributes() end)
    if ok and attrs then
        for an, v in pairs(attrs) do
            local low = string.lower(an)
            if (string.find(low, "level") or string.find(low, "rank")) and v ~= nil and v ~= "" then return tostring(v) end
        end
    end
    if char then
        local ok2, cAttrs = pcall(function() return char:GetAttributes() end)
        if ok2 and cAttrs then
            for an, v in pairs(cAttrs) do
                local low = string.lower(an)
                if (string.find(low, "level") or string.find(low, "rank")) and v ~= nil and v ~= "" then return tostring(v) end
            end
        end
    end
    local ls = player:FindFirstChild("leaderstats")
    if ls then
        for _, n in ipairs({"Level","Rank","Lvl"}) do
            local o = ls:FindFirstChild(n)
            if o then return tostring(o.Value) end
        end
    end
    for _, obj in ipairs(player:GetChildren()) do
        if obj:IsA("IntValue") or obj:IsA("NumberValue") or obj:IsA("StringValue") then
            local low = string.lower(obj.Name)
            if string.find(low, "level") or string.find(low, "rank") then return tostring(obj.Value) end
        end
    end
    return "?"
end

