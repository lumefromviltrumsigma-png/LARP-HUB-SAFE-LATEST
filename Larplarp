local function CreateTab(name, order)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.fromOffset(44, 20)
    Btn.BackgroundColor3 = COLORS.Surface
    Btn.BackgroundTransparency = 0.2
    Btn.Text = name
    Btn.TextColor3 = COLORS.TextDim
    Btn.TextSize = 8
    Btn.Font = Enum.Font.GothamBold
    Btn.AutoButtonColor = false
    Btn.LayoutOrder = order
    Btn.ZIndex = 3
    Btn.Parent = TabBar
    Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 5)
    local BtnStroke = Instance.new("UIStroke", Btn)
    BtnStroke.Color = COLORS.Border
    BtnStroke.Thickness = 1

    local Content = Instance.new("ScrollingFrame")
    Content.Size = UDim2.new(1, 0, 1, 0)
    Content.BackgroundTransparency = 1
    Content.BorderSizePixel = 0
    Content.ScrollBarThickness = 1.5
    Content.ScrollBarImageColor3 = COLORS.BorderHover
    Content.ScrollBarImageTransparency = 0.3
    Content.Visible = false
    Content.CanvasSize = UDim2.new(0, 0, 0, 0)
    Content.ZIndex = 3
    Content.Parent = ContentHolder
    local Layout = Instance.new("UIListLayout", Content)
    Layout.SortOrder = Enum.SortOrder.LayoutOrder
    Layout.Padding = UDim.new(0, 4)
    Layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        Content.CanvasSize = UDim2.new(0, 0, 0, Layout.AbsoluteContentSize.Y + 6)
    end)
    local Padding = Instance.new("UIPadding", Content)
    Padding.PaddingRight = UDim.new(0, 4)
    Padding.PaddingBottom = UDim.new(0, 6)

    local tab = { Name = name, Button = Btn, Stroke = BtnStroke, Content = Content, Layout = Layout }

    Btn.MouseEnter:Connect(function()
        if currentTab == tab then return end
        TweenService:Create(Btn, EASE.Fast, {BackgroundColor3 = COLORS.SurfaceHover, TextColor3 = COLORS.Text}):Play()
        TweenService:Create(BtnStroke, EASE.Fast, {Color = COLORS.BorderHover}):Play()
    end)
    Btn.MouseLeave:Connect(function()
        if currentTab == tab then return end
        TweenService:Create(Btn, EASE.Fast, {BackgroundColor3 = COLORS.Surface, TextColor3 = COLORS.TextDim}):Play()
        TweenService:Create(BtnStroke, EASE.Fast, {Color = COLORS.Border}):Play()
    end)
    Btn.MouseButton1Click:Connect(function()
        if currentTab == tab then return end
        if currentTab then
            currentTab.Content.Visible = false
            TweenService:Create(currentTab.Button, EASE.Fast, {BackgroundColor3 = COLORS.Surface, TextColor3 = COLORS.TextDim}):Play()
            TweenService:Create(currentTab.Stroke, EASE.Fast, {Color = COLORS.Border}):Play()
        end
        currentTab = tab
        Content.Visible = true
        TweenService:Create(Btn, EASE.Fast, {BackgroundColor3 = COLORS.Accent, TextColor3 = COLORS.AccentText}):Play()
        TweenService:Create(BtnStroke, EASE.Fast, {Color = COLORS.Accent}):Play()
    end)

    tabs[name] = tab
    return tab
end

