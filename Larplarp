            nl.BackgroundTransparency = 1
            nl.Text = player.Name
            nl.TextColor3 = Color3.new(1, 1, 1)
            nl.TextSize = 12
            nl.Font = Enum.Font.GothamBold
            nl.TextStrokeTransparency = 0.2
            local hpl = Instance.new("TextLabel", bb)
            hpl.Size = UDim2.new(1, 0, 0, 16)
            hpl.Position = UDim2.new(0, 0, 0, 18)
            hpl.BackgroundTransparency = 1
            hpl.Text = "HP: " .. math.floor(hum.Health) .. " / " .. math.floor(hum.MaxHealth)
            hpl.TextColor3 = Color3.new(1, 1, 1)
            hpl.TextSize = 10
            hpl.Font = Enum.Font.GothamMedium
            hpl.TextStrokeTransparency = 0.2
            hum.HealthChanged:Connect(function(h)
                hpl.Text = "HP: " .. math.floor(h) .. " / " .. math.floor(hum.MaxHealth)
