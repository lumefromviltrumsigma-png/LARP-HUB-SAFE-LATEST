local POWER_ATTR_NAMES = {"_EquippedPower","EquippedPower","CurrentPower","_Power","Power","Equipped_Power","ActivePower"}
local EspPowersEnabled = false
local espPowerBillboards = {}
local espPowerConnections = {}
local espPowerPoller = nil

local function GetPlayerPower(player)
    for _, n in ipairs(POWER_ATTR_NAMES) do
        local ok, v = pcall(function() return player:GetAttribute(n) end)
        if ok and v ~= nil then
            local s = tostring(v)
            if s ~= "" and s ~= "None" and s ~= "Yok" and s ~= "nil" then return s end
        end
    end
    return nil
end

local function UpdateEspPower(player)
    if not player or player == LocalPlayer then return end
    if not player.Parent then
        if espPowerBillboards[player] then pcall(function() espPowerBillboards[player]:Destroy() end) espPowerBillboards[player] = nil end
        return
    end
    local char = player.Character
    local head = char and char:FindFirstChild("Head")
    local power = GetPlayerPower(player)
    if EspPowersEnabled and head and power then
        local e = espPowerBillboards[player]
        if e and e.Parent == head then
            local l = e:FindFirstChildOfClass("TextLabel")
            if l and l.Text ~= power then l.Text = power end
        else
            if e then pcall(function() e:Destroy() end) end
            local bb = Instance.new("BillboardGui")
            bb.Name = "Larp_PowerESP"
            bb.AlwaysOnTop = false
            bb.Size = UDim2.new(0, 130, 0, 24)
            bb.StudsOffset = Vector3.new(0, 2.4, 0)
            bb.LightInfluence = 0
            bb.MaxDistance = 750
            bb.Adornee = head
            local l = Instance.new("TextLabel")
            l.BackgroundTransparency = 1
            l.Size = UDim2.new(1, 0, 1, 0)
            l.Text = power
            l.TextColor3 = Color3.new(1, 1, 1)
            l.TextStrokeColor3 = Color3.new(0, 0, 0)
            l.TextStrokeTransparency = 0.35
            l.Font = Enum.Font.GothamBold
            l.TextScaled = true
            l.TextWrapped = true
            l.Parent = bb
            bb.Parent = head
            espPowerBillboards[player] = bb
        end
    else
        local e = espPowerBillboards[player]
        if e then pcall(function() e:Destroy() end) espPowerBillboards[player] = nil end
    end
end

local function BindEspPower(player)
    if player == LocalPlayer then return end
    if espPowerConnections[player] then
        for _, c in pairs(espPowerConnections[player]) do if c and c.Connected then pcall(function() c:Disconnect() end) end end
    end
    espPowerConnections[player] = {}
    for _, n in ipairs(POWER_ATTR_NAMES) do
        local ok, sig = pcall(function() return player:GetAttributeChangedSignal(n) end)
        if ok and sig then
            table.insert(espPowerConnections[player], sig:Connect(function() if EspPowersEnabled then UpdateEspPower(player) end end))
        end
    end
    table.insert(espPowerConnections[player], player.CharacterAdded:Connect(function() task.wait(0.6) if EspPowersEnabled then UpdateEspPower(player) end end))
    table.insert(espPowerConnections[player], player.CharacterRemoving:Connect(function()
        if espPowerBillboards[player] then pcall(function() espPowerBillboards[player]:Destroy() end) espPowerBillboards[player] = nil end
    end))
    UpdateEspPower(player)
end

local function CleanupEspPowers()
    for _, l in pairs(espPowerConnections) do
        for _, c in ipairs(l) do if c and c.Connected then pcall(function() c:Disconnect() end) end end
    end
    table.clear(espPowerConnections)
    for _, b in pairs(espPowerBillboards) do if b then pcall(function() b:Destroy() end) end end
    table.clear(espPowerBillboards)
end

tglEspPowers.Button.MouseButton1Click:Connect(function()
    EspPowersEnabled = not EspPowersEnabled
    SetToggleVisual(tglEspPowers, EspPowersEnabled)
    if EspPowersEnabled then
        CleanupEspPowers()
        for _, p in ipairs(Players:GetPlayers()) do if p ~= LocalPlayer then BindEspPower(p) end end
        table.insert(espPowerConnections, Players.PlayerAdded:Connect(function(p) task.wait(1) if EspPowersEnabled then BindEspPower(p) end end))
        table.insert(espPowerConnections, Players.PlayerRemoving:Connect(function(p)
            if espPowerBillboards[p] then pcall(function() espPowerBillboards[p]:Destroy() end) espPowerBillboards[p] = nil end
            if espPowerConnections[p] then
                for _, c in pairs(espPowerConnections[p]) do if c and c.Connected then pcall(function() c:Disconnect() end) end end
                espPowerConnections[p] = nil
            end
        end))
        if not espPowerPoller then
            espPowerPoller = task.spawn(function()
                while EspPowersEnabled do
                    for _, p in ipairs(Players:GetPlayers()) do if p ~= LocalPlayer then UpdateEspPower(p) end end
                    task.wait(0.35)
                end
                espPowerPoller = nil
            end)
        end
    else
        CleanupEspPowers()
        espPowerPoller = nil
    end
    PlayToggleSound()
end)

